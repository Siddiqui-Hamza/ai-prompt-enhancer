{
  "name": "AI Prompt Enhancer",
  "description": "Transform rough prompts into high-quality, well-structured prompts for ChatGPT and other LLMs",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "https://localhost:8080/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*"
  ],

  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*"
      ],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*"
      ]
    }
  ],

  "action": {
    "default_title": "AI Prompt Enhancer",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },

  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
